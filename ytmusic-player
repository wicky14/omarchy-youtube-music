#!/usr/bin/env bash
# Launch mpv detached (own session) so playback survives `omarchy restart shell`.
#
# Usage:
#   ytmusic-player start <url> <title> <artist> <volume>
#   ytmusic-player stop
#   ytmusic-player stop-check
#   ytmusic-player is-running
#
# mpv is spawned with setsid so it becomes a session leader that is NOT a
# child of the Quickshell process; killing/restarting Quickshell leaves the
# audio running. This script then WAITS on the mpv process so that whatever
# spawned it (the QML Process) stays alive for the duration of the track —
# allowing track-advance logic to react when mpv exits.
#
# mpv.pid holds the detatched mpv pid so `stop` can kill it explicitly.
set -euo pipefail

: "${XDG_RUNTIME_DIR:?ytmusic-player requires XDG_RUNTIME_DIR}"
runtime_dir="$XDG_RUNTIME_DIR/omarchy-ytmusic"
socket="$runtime_dir/mpv-socket"
pid_file="$runtime_dir/mpv.pid"
log_file="$runtime_dir/mpv.log"

mkdir -p "$runtime_dir"

is_running() {
  [[ -S "$socket" ]] || return 1
  if [[ -s "$pid_file" ]]; then
    local pid
    read -r pid < "$pid_file"
    if [[ $pid =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null; then return 0; fi
  fi
  return 1
}

stop_player() {
  if [[ -S "$socket" ]]; then
    { printf '{"command":["stop"]}\n{"command":["quit"]}\n' | socat - "$socket" 2>/dev/null; } || true
  fi
  if [[ -s "$pid_file" ]]; then
    local pid
    read -r pid < "$pid_file" || true
    if [[ $pid =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null; then
      kill "$pid" 2>/dev/null || true
      for _ in $(seq 1 100); do
        kill -0 "$pid" 2>/dev/null || break
        sleep 0.05
      done
      if kill -0 "$pid" 2>/dev/null; then
        kill -KILL "$pid" 2>/dev/null || true
      fi
    fi
  fi
  rm -f "$socket" "$pid_file"
}

cmd_start() {
  local url="${1:-}" title="${2:-}" artist="${3:-}" volume="${4:-70}"
  [[ -n "$url" ]] || { echo "ytmusic-player: start requires a url" >&2; exit 1; }
  # Kill any existing player before starting a new one.
  stop_player
  local volume_num
  volume_num=$(printf '%s\n' "$volume" | awk '{ if ($1+0 < 0) print 0; else if ($1+0 > 100) print 100; else print int($1+0); }')
  setsid mpv \
    --no-video \
    --term-osd-bar \
    --input-ipc-server="$socket" \
    --ytdl \
    --script-opts=ytdl_hook-ytdl_path=yt-dlp \
    --volume="$volume_num" \
    --force-media-title="$(printf '%s' "$title")" \
    "$url" >>"$log_file" 2>&1 &
  local mpv_pid=$!
  echo "$mpv_pid" > "$pid_file"
  # Wait for the socket to appear so callers can connect.
  for _ in $(seq 1 200); do
    [[ -S "$socket" ]] && break
    kill -0 "$mpv_pid" 2>/dev/null || break
    sleep 0.05
  done
  # Block until mpv exits, propagating its exit status. Killing/restarting
  # Quickshell does NOT signal this script's mpv (it is detached); it only
  # kills this waiting shell, which is fine: a fresh shell reconnects to the
  # still-running mpv and clears any stale state itself.
  wait "$mpv_pid"
}

case "${1:-}" in
  start)
    shift
    cmd_start "$@"
    ;;
  stop)
    stop_player
    ;;
  stop-check)
    stop_player
    # After a graceful stop, report whether anything still runs.
    if is_running; then exit 1; else exit 0; fi
    ;;
  is-running)
    if is_running; then exit 0; else exit 1; fi
    ;;
  *)
    echo "usage: $0 {start <url> [title] [artist] [volume] | stop | stop-check | is-running}" >&2
    exit 1
    ;;
esac
